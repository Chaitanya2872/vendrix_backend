DATABASE_URL=sqlite:///./iotiq.db
JWT_SECRET=replace-with-a-long-random-secret
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_ENABLED=false
# Mount an ANPR-trained YOLO model in the worker container and point to it here.
PLATE_DETECTOR_MODEL_PATH=/models/license-plate-detector.pt
